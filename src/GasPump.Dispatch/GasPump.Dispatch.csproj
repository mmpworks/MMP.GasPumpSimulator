<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GasPump.Dispatch</RootNamespace>
    <!-- MMP.AsyncProxy is not on NuGet yet. Until it is, the third dispatch strategy references the sibling
         checkout under AsyncProxyRoot (Directory.Build.props). Override with -p:AsyncProxyRoot=..., or
         with -p:AsyncProxyProjectPath=... for the project file alone. Swap for a PackageReference
         when the package publishes. -->
    <AsyncProxyProjectPath Condition="'$(AsyncProxyProjectPath)' == ''">$(AsyncProxyRoot)\src\MMP.AsyncProxy\MMP.AsyncProxy.csproj</AsyncProxyProjectPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GasPump.Core\GasPump.Core.csproj" />
    <ProjectReference Include="..\GasPump.Payment\GasPump.Payment.csproj" />
    <ProjectReference Include="..\GasPump.Security\GasPump.Security.csproj" />
    <ProjectReference Include="..\GasPump.Pump\GasPump.Pump.csproj" />
    <ProjectReference Include="..\GasPump.Custody\GasPump.Custody.csproj" />
    <ProjectReference Include="..\GasPump.Reader\GasPump.Reader.csproj" />
    <ProjectReference Include="..\GasPump.Bank\GasPump.Bank.csproj" />
    <ProjectReference Include="$(AsyncProxyProjectPath)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The simulator's log runs on Herald.OSS. See HeraldEventLog.cs. -->
    <PackageReference Include="Herald.OSS" Version="0.14.0" />
  </ItemGroup>
</Project>
