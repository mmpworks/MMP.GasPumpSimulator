{
  "name": "gaspump-simulator-app",
  "private": true,
  "version": "0.1.0",
  "description": "Electron front end for MMP.GasPumpSimulator",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vue-tsc": "2.2.0",
    "wait-on": "8.0.1"
  }
}
