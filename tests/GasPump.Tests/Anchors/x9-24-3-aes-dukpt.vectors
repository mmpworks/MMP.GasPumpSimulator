# AES DUKPT test values for anchor A1 of MMP.GasPumpSimulator (docs/prd-dukpt-reader.md, section 5).
#
# The values come from the supplement to ANSI X9.24-3-2017, the AES DUKPT test vectors published by
# ASC X9, Inc.: X9.24-3-2017-Test-Vectors-20180129-1.pdf (ASC X9, 2018-01-29, SHA-256 AE9BB01D76EDA32018332F1202A9C2010097ABF0D17D753612B7E612DDD9C4CC).
# ASC X9 has not reviewed or endorsed this project.
# These values are test data from a published file. The keys protect nothing.
# The values are facts from the ASC X9 supplement. The MIT licence of this repo covers MMPWorks' code.
# This file makes no claim of ownership over the values.
#
# tools/extract-x9-vectors.py wrote this file from the fetched PDF text. Run the tool again; do not edit by hand.
# Format: "[group]", then "source:", then one "name = value" per line. Values are hex, except pan and pin.

[setup]
source: X9.24-3-2017-Test-Vectors-20180129-1.pdf (ASC X9, 2018-01-29, SHA-256 AE9BB01D76EDA32018332F1202A9C2010097ABF0D17D753612B7E612DDD9C4CC), section 2.2, "Test Vectors for Various Transaction Keys": BDK-128, InitialKeyID, and the AES-128 Initial Key of each transaction
bdk = FEDCBA9876543210F1F1F1F1F1F1F1F1
initial-key-id = 1234567890123456
initial-key = 1273671EA26AC29AFA4D1084127652A1

[pin-block-inputs]
source: X9.24-3-2017-Test-Vectors-20180129-1.pdf (ASC X9, 2018-01-29, SHA-256 AE9BB01D76EDA32018332F1202A9C2010097ABF0D17D753612B7E612DDD9C4CC), section 2.2, "Calculation of AES PIN Block (Format 4)", the same in transactions 1 to 8
pan = 4111111111111111
pin = 1234
random = 2F69ADDE2E9E7ACE

